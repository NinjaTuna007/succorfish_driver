<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>succorfish_driver</name>
  <version>0.0.0</version>
  <description>
    Transparent serial bridge node: owns one serial port (Succorfish modem at
    9600/ttyUSB or Teensy front-end at 115200/ttyACM) and exposes it to the ROS
    graph as RX/TX line topics plus a generic synchronous SendCommand service.
  </description>
  <maintainer email="sdup@kth.se">Shekhar Devm Upadhyay</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>succorfish_msgs</depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
